VALIDATOR_URL=https://example.com/validatorapi
ASYNC_JOBS=false
# Scenario specs answer validator calls from fhir_stub_server at this URL.
FHIR_RESOURCE_VALIDATOR_URL=http://validator.stub.test
# The TLS test opens a real TLS connection, which no Scenario's stub can answer.
INFERNO_DISABLE_TLS_TEST=true
